{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newshub.example/schemas/signed-metadata-envelope.schema.json",
  "title": "NewsHub signed metadata envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["signatures", "signed"],
  "properties": {
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sig": { "type": "string", "contentEncoding": "base64" }
        }
      }
    },
    "signed": {
      "type": "object",
      "required": ["_type", "expires", "specVersion", "version"],
      "properties": {
        "_type": { "enum": ["root", "targets", "snapshot", "timestamp"] },
        "expires": { "type": "string", "format": "date-time" },
        "specVersion": { "const": "1.0" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
